# Bundling rilis LOKAL saja: `npx expo export`, `npx expo run:* --variant release`.
# Mengalahkan .env (dev server di laptop) — karena itu SETIAP EXPO_PUBLIC_* yang
# dibaca aplikasi didefinisikan di sini, walau kosong, supaya nilai .env (IP laptop)
# tidak ikut tertanam ke bundle rilis.
#
# Build EAS dan `eas update --environment preview|production` TIDAK membaca berkas
# ini (eas update dengan --environment menyetel EXPO_NO_DOTENV=1). Nilainya dari
# EAS environment variables — samakan dengan `npx eas-cli@latest env:set`
# (docs/RILIS.md). Selalu jalankan `eas update` dengan --environment.
#
# Server situs dengan /api/mobile/* (branch feat/api-mobile di repo situs; belum
# ter-deploy ke produksi, lihat docs/RILIS.md). Kosong = MODE DEMO — bundling rilis
# menolaknya (app.config.js), begitu juga http:// (Android rilis menolak cleartext).
EXPO_PUBLIC_API_URL=https://fire.nusantara.earth

# Situs sumber beranda (umpan, komentar). Kosong = https://fire.nusantara.earth.
EXPO_PUBLIC_SITUS_URL=https://fire.nusantara.earth

# Login Google (docs/AKUN.md): OAuth client "Web application" & iOS. Kosong = tombol
# Google nonaktif (Apple tetap ada di iOS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Email kontak publik — wajib untuk toko aplikasi (Pengaturan → Hubungi kami, serta
# teks Ketentuan & Privasi). Build toko menolak bila kosong (app.config.js).
EXPO_PUBLIC_KONTAK_EMAIL=
