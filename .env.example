# Alamat server yang menerima laporan (tanpa garis miring di akhir).
# Kosong = MODE DEMO: unggahan disimulasikan, tidak ada yang dikirim.
#
# Contoh:
#   Mock server di laptop  : http://192.168.1.10:4000   (node mock-server/server.mjs)
#   Situs lokal (next dev) : http://192.168.1.10:3000   (setelah endpoint di docs/API.md dipasang)
#   Produksi               : https://fire.nusantara.earth
EXPO_PUBLIC_API_URL=

# Situs sumber beranda (umpan laporan, komentar) — hanya-baca, lihat docs/UMPAN.md.
# Kosong = https://fire.nusantara.earth. Isi http://<IP-laptop>:3000 untuk situs lokal (next dev).
EXPO_PUBLIC_SITUS_URL=

# Login Google (docs/AKUN.md) — OAuth client ID tipe "Web application".
# Kosong = tombol "Lanjutkan dengan Google" nonaktif (masuk uji tetap bisa di dev server).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Hanya untuk iOS: OAuth client iOS. GOOGLE_IOS_URL_SCHEME dipakai app.config.js saat build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
